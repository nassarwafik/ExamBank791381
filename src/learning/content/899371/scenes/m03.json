      "kind": "text",
      "x": 200,
      "y": 178,
      "text": "",
      "big": true,
      "mono": true
     }
    ],
    "steps": [
     {
      "say": "`Math.Abs` يعطي بُعد العدد عن الصفر بلا إشارة. نبدأ من `-7`."
     },
     {
      "say": "`-7` يبعد 7 خطوات عن الصفر، فالناتج 7.",
      "set": {
       "tk": {
        "x": 357.5,
        "text": "7",
        "tone": "ok"
       },
       "res": {
        "text": "Math.Abs(-7) = 7",
        "tone": "ok"
       }
      }
     },
     {
      "say": "`Math.Round` يقرّب إلى أقرب عدد صحيح. `5.6` يقع بين 5 و6.",
      "set": {
       "expr": {
        "text": "Math.Round(5.6)"
       },
       "tk": {
        "x": 326.0,
        "text": "5.6",
        "tone": "accent"
       },
       "res": {
        "text": "",
        "tone": "base"
       }
      }
     },
     {
      "say": "`5.6` أقرب إلى 6 منه إلى 5، فالناتج 6.",
      "set": {
       "tk": {
        "x": 335.0,
        "text": "6",
        "tone": "ok"
       },
       "res": {
        "text": "Math.Round(5.6) = 6",
        "tone": "ok"
       }
      }
     },
     {
      "say": "`Math.Floor` يحذف الجزء العشري. نبدأ من `7.9`، وهو قريب جدًا من 8.",
      "set": {
       "expr": {
        "text": "Math.Floor(7.9)"
       },
       "tk": {
        "x": 377.75,
        "text": "7.9",
        "tone": "accent"
       },
       "res": {
        "text": "",
        "tone": "base"
       }
      }
     },
     {
      "say": "`Floor` لا يقرّب: يحذف الجزء العشري فيعطي 7 رغم القرب من 8.",
      "set": {
       "tk": {
        "x": 357.5,
        "text": "7",
        "tone": "warn"
       },
       "res": {
        "text": "Math.Floor(7.9) = 7",
        "tone": "warn"
       }
      }
     }
    ]
   }
