l01-p02-cmd","type":"code","origin":"book","language":"cli","dir":"ltr","code":"C:\\> ipconfig /all"},{"id":"m11-l01-p02-func","type":"text","origin":"book","spans":[{"text":"الوظيفة:","style":"strong"},{"text":" يعرض إعدادات الشبكة في جهازك: "},{"text":"عنوان IP","style":"strong"},{"text":"، "},{"text":"قناع الشبكة","style":"strong"},{"text":"، "},{"text":"البوابة الافتراضية","style":"strong"},{"text":"، و "},{"text":"عنوان MAC","style":"strong"},{"text":"."}]}]},{"id":"791381s-m11-l01-p03","title":"الأمر tracert","order":3,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":33},"blocks":[{"id":"m11-l01-p03-intro","type":"text","origin":"book","spans":[{"text":"يفيدنا لنعرف في أي مكان على الطريق تتوقّف الرسالة أو تتأخّر."}]},{"id":"m11-l01-p03-cmd","type":"code","origin":"book","language":"cli","dir":"ltr","code":"C:\\> tracert google.com"},{"id":"m11-l01-p03-func","type":"text","origin":"book","spans":[{"text":"الوظيفة:","style":"strong"},{"text":" يعرض الطريق الذي تسلكه الرسالة حتى تصل إلى الموقع، "},{"text":"خطوة بعد خطوة","style":"strong"},{"text":" (راوتر بعد راوتر)."}]},{"id":"m11-l01-p03-v-tracert","type":"visual","origin":"teacher-enrichment","visualId":"791381/m15/tracert-hops","motion":true,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":33},"title":"رسم توضيحي: tracert يعرض الطريق خطوة بعد خطوة","alt":"رسم فيه «جهازك» على اليسار و«الوجهة» على اليمين، وبينهما ثلاث محطات مرقّمة 1 و 2 و 3 (راوتر بعد راوتر)، ورزمة تتقدّم من محطة إلى التي بعدها حتى تصل إلى الوجهة.","caption":"tracert يعرض الطريق الذي تسلكه الرسالة حتى تصل إلى الموقع، راوترًا بعد راوتر."}]},{"id":"791381s-m11-l01-p04","title":"الأمر nslookup","order":4,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":33},"blocks":[{"id":"m11-l01-p04-intro","type":"text","origin":"book","spans":[{"text":"إذا فتح الموقع بالعنوان الرقمي ولم يفتح بالاسم، فغالبًا المشكلة في DNS."}]},{"id":"m11-l01-p04-cmd","type":"code","origin":"book","language":"cli","dir":"ltr","code":"C:\\> nslook