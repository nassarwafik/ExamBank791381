{"id":"791381s-m35","title":"التوجيه والأمان","order":35,"lessons":[{"id":"791381s-m35-l00","title":"افتتاحية الوحدة","order":0,"pages":[{"id":"791381s-m35-l00-p01","title":"التوجيه والأمان","order":1,"layout":"opener","source":{"kind":"book","sourceId":"791381s","pdfPageStart":105},"blocks":[{"id":"m35-l00-p01-opener","type":"unit-opener","origin":"book","unitLabel":"الملخص الشامل ⑤ · كتاب ص 251–257","unitNumber":"35","title":"التوجيه والأمان","subtitle":"أنواع المسارات · AD · مقارنة البروتوكولات · الهجمات · Port Security · كلمات المرور · ACL"}]}]},{"id":"791381s-m35-l01","title":"التوجيه والأمان","order":1,"pages":[{"id":"791381s-m35-l01-p01","title":"أنواع المسارات","order":1,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":105},"blocks":[{"id":"m35-l01-p01-cards","type":"list","origin":"book","variant":"cards","items":[{"id":"m35-l01-p01-c1","term":"Static Route","text":[{"text":"مسار يدوي يُدخله المدير. سريع وآمن لكنه لا يتغيّر تلقائيًا. "},{"text":"ip route ...","style":"code"}]},{"id":"m35-l01-p01-c2","term":"Dynamic Route","text":[{"text":"تلقائي عبر بروتوكولات ذكية تتعلّم الشبكات. "},{"text":"OSPF · EIGRP","style":"strong"}]},{"id":"m35-l01-p01-c3","term":"Default Route","text":[{"text":"مسار افتراضي 0.0.0.0/0 لكل ما هو غير معروف. "},{"text":"0.0.0.0 0.0.0.0","style":"code"}]}]},{"id":"m35-l01-p01-cli-h","type":"heading","origin":"book","level":4,"text":"Router CLI","dir":"ltr"},{"id":"m35-l01-p01-cli","type":"code","origin":"book","language":"cli","dir":"ltr","code":"① Router(config)# ip route 192.168.2.0 255.255.255.0 10.0.0.2\n② Router(config)# ip route 0.0.0.0 0.0.0.0 10.0.0.2"},{"id":"m35-l01-p01-steps","type":"list","origin":"book","variant":"ordered","items":[{"id":"m35-l01-p01-s1","text":[{"text":"مسار ثابت إلى الشبكة 192.168.2.0/24 عبر 10.0.0.2."}]},{"id":"m35-l01-p01-s2","text":[{"text":"مسار افتراضي: أي شبكة غير معروفة تُرسل إلى 10.0.0.2."}]}]}]},{"id":"791381s-m35-l01-p02","title":"المسافة الإدارية AD","order":2,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":105},"blocks":[{"id":"m35-l01-p02-table","type":"table","origin":"book","headers":["البروتوكول","Connected","Static","EIGRP","OSPF","RIP"],"rows":[["AD","0","1","90","110","120"]]},{"id":"m35-l01-p02-remember","type":"callout","origin":"book","kind":"remember","title":"تذكّر","spans":[{"text":"عند وجود أكثر من مسار لنفس الشبكة، يختار الراوتر "},{"text":"الأقلّ AD","style":"strong"},{"text":": Connected ثم Static ثم EIGRP ثم OSPF ثم RIP."}]}]},{"id":"791381s-m35-l01-p03","title":"بروتوكولات التوجيه — مقارنة","order":3,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":106},"blocks":[{"id":"m35-l01-p03-table","type":"table","origin":"book","headers":["البروتوكول","النوع","AD","المقياس Metric"],"rows":[["RIP","Distance Vector (قديم)","120","عدد القفزات Hops"],["OSPF","Link-State (ذكي)","110","Cost (سرعة الخط)"],["EIGRP","Hybrid (Cisco فقط)","90","Bandwidth + Delay"]]},{"id":"m35-l01-p03-cli-h","type":"heading","origin":"book","level":4,"text":"Router CLI","dir":"ltr"},{"id":"m35-l01-p03-cli","type":"code","origin":"book","language":"cli","dir":"ltr","code":"① R(config)# router ospf 1\n② R(config-router)# network 192.168.1.0 0.0.0.255 area 0\n③ R(config)# router eigrp 100\n④ R(config-router)# network 192.168.1.0 0.0.0.255"},{"id":"m35-l01-p03-memo-h","type":"heading","origin":"book","level":4,"text":"للتذكّر"},{"id":"m35-l01-p03-memo1","type":"text","origin":"book","spans":[{"text":"OSPF من نوع "},{"text":"Link-State","style":"strong"},{"text":"، وEIGRP من نوع "},{"text":"Hybrid","style":"strong"},{"text":" خاص بـ Cisco، وRIP من نوع "},{"text":"Distance Vector","style":"strong"},{"text":" قديم."}]},{"id":"m35-l01-p03-memo2","type":"text","origin":"book","spans":[{"text":"في EIGRP يمكن كتابة Wildcard بعد الشبكة أو تركه."}]}]},{"id":"791381s-m35-l01-p04","title":"الهجمات الشائعة","order":4,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":106,"pdfPageEnd":107},"blocks":[{"id":"m35-l01-p04-table","type":"table","origin":"book","headers":["الهجوم","المعنى","الوصف"],"rows":[["DoS","Denial of Service","تعطيل الخدمة من جهاز واحد"],["DDoS","Distributed DoS","تعطيل من أجهزة كثيرة"],["Spoofing","تزييف","تزييف IP / MAC / DNS"],["MitM","الرجل الوسيط","اعتراض الاتصال بين طرفين"],["Sniffing","تنصّت","التقاط البيانات"],["Hijacking","اختطاف الجلسة","سرقة الجلسة Session"],["Phishing","احتيال","صفحات / إيميلات مزيّفة"]]},{"id":"m35-l01-p04-prevention","type":"callout","origin":"book","kind":"summary","title":"الوقاية","spans":[{"text":"التشفير (HTTPS / VPN / SSH)، وكلمات المرور القوية، و Port Security، و ACL — تقلّل أثر هذه الهجمات."}]}]},{"id":"791381s-m35-l01-p05","title":"تأمين المنافذ Port Security","order":5,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":107},"blocks":[{"id":"m35-l01-p05-cli-h","type":"heading","origin":"book","level":4,"text":"Switch CLI","dir":"ltr"},{"id":"m35-l01-p05-cli","type":"code","origin":"book","language":"cli","dir":"ltr","code":"① Switch(config-if)# switchport mode access\n② Switch(config-if)# switchport port-security\n③ Switch(config-if)# switchport port-security maximum 2\n④ Switch(config-if)# switchport port-security mac-address sticky\n⑤ Switch(config-if)# switchport port-security violation shutdown"},{"id":"m35-l01-p05-steps","type":"list","origin":"book","variant":"ordered","items":[{"id":"m35-l01-p05-s1","text":[{"text":"وضع Access — مطلوب لتفعيل الحماية."}]},{"id":"m35-l01-p05-s2","text":[{"text":"تفعيل الميزة."}]},{"id":"m35-l01-p05-s3","text":[{"text":"عدد الأجهزة المسموح بها: 2."}]},{"id":"m35-l01-p05-s4","text":[{"text":"sticky","style":"strong"},{"text":": السويتش يتعلّم عناوين MAC تلقائيًا ويحفظها."}]},{"id":"m35-l01-p05-s5","text":[{"text":"الإجراء عند المخالفة: إغلاق المنفذ."}]}]},{"id":"m35-l01-p05-table","type":"table","origin":"book","headers":["نوع المخالفة","ماذا يحدث؟"],"rows":[["Shutdown","إغلاق المنفذ (err-disabled)."],["Restrict","إسقاط البيانات مع تنبيه."],["Protect","إسقاط البيانات بلا تنبيه."]]}]},{"id":"791381s-m35-l01-p06","title":"تأمين الوصول بكلمات المرور و SSH","order":6,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":108},"blocks":[{"id":"m35-l01-p06-cli-h","type":"heading","origin":"book","level":4,"text":"Switch / Router CLI","dir":"ltr"},{"id":"m35-l01-p06-cli","type":"code","origin":"book","language":"cli","dir":"ltr","code":"① (config)# line console 0\n② (config-line)# password cisco\n③ (config-line)# login\n④ (config)# line vty 0 4\n⑤ (config-line)# password cisco\n⑥ (config-line)# login\n⑦ (config)# enable secret cisco123\n⑧ (config)# service password-encryption"},{"id":"m35-l01-p06-lines","type":"list","origin":"book","variant":"plain","items":[{"id":"m35-l01-p06-l1","text":[{"text":"الأسطر 1–3: حماية الوصول المحلي بالكابل (Console)."}]},{"id":"m35-l01-p06-l2","text":[{"text":"الأسطر 4–6: حماية الدخول عن بُعد (VTY)."}]},{"id":"m35-l01-p06-l3","text":[{"text":"السطر 7: كلمة مرور "},{"text":"مشفّرة","style":"strong"},{"text":" للوضع المميّز (#)."}]},{"id":"m35-l01-p06-l4","text":[{"text":"السطر 8: تشفير كل كلمات المرور في الإعدادات."}]}]},{"id":"m35-l01-p06-ssh","type":"callout","origin":"book","kind":"summary","title":"SSH","spans":[{"text":"SSH","style":"strong"},{"text":" بديل آمن ومشفّر لـ Telnet لتسجيل الدخول إلى السويتش أو الراوتر عبر الشبكة (المنفذ 22)."}]}]},{"id":"791381s-m35-l01-p07","title":"قوائم التحكم بالوصول ACL","order":7,"source":{"kind":"book","sourceId":"791381s","pdfPageStart":108,"pdfPageEnd":109},"blocks":[{"id":"m35-l01-p07-table","type":"table","origin":"book","headers":["النوع","الرقم","الفلترة","التطبيق"],"rows":[["Standard ACL","1–99","المصدر فقط (Source IP)","قريب من الوجهة"],["Extended ACL","100–199","IP + Port + Protocol","قريب من المصدر"]],"columnDirs":["rtl","ltr","rtl","rtl"]},{"id":"m35-l01-p07-cli-h","type":"heading","origin":"book","level":4,"text":"Router CLI","dir":"ltr"},{"id":"m35-l01-p07-cli","type":"code","origin":"book","language":"cli","dir":"ltr","code":"① (config)# access-list 10 permit 192.168.1.0 0.0.0.255\n② (config-if)# ip access-group 10 out\n③ (config)# access-list 100 permit tcp 192.168.1.0 0.0.0.255 any eq 80\n④ (config-if)# ip access-group 100 in"},{"id":"m35-l01-p07-steps","type":"list","origin":"book","variant":"ordered","items":[{"id":"m35-l01-p07-s1","text":[{"text":"Standard: السماح لشبكة 192.168.1.0/24."}]},{"id":"m35-l01-p07-s2","text":[{"text":"تطبيقها على الواجهة للبيانات الخارجة."}]},{"id":"m35-l01-p07-s3","text":[{"text":"Extended: السماح للشبكة بالتصفّح HTTP إلى أي وجهة."}]},{"id":"m35-l01-p07-s4","text":[{"text":"تطبيقها على الواجهة للبيانات الداخلة."}]}]},{"id":"m35-l01-p07-rule","type":"callout","origin":"book","kind":"summary","title":"القاعدة","spans":[{"text":"Standard","style":"strong"},{"text":" قريبة من الوجهة (تفحص المصدر فقط)، و"},{"text":"Extended","style":"strong"},{"text":" قريبة من المصدر (تفحص المصدر والوجهة والمنفذ)."}]}]}]}]}
