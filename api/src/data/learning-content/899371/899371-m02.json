],["/","القسمة الكسرية","5.0 / 2","2.5"],["%","باقي القسمة","7 % 3","1"]],"columnDirs":["ltr","rtl","ltr","ltr"]},{"id":"m02-l01-p02-b04","type":"text","origin":"book","spans":[{"text":"🧠 "},{"text":"ملاحظة:","style":"strong"},{"text":" القسمة بين عددين صحيحين تعطي عددًا صحيحًا (بدون فواصل)."}]},{"id":"m02-l01-p02-b05","type":"heading","origin":"book","level":3,"text":"🔹 ب. العوامل المنطقية (Logical Operators):"},{"id":"m02-l01-p02-b06","type":"table","origin":"book","headers":["العامل","الاسم","الاستخدام","مثال","النتيجة"],"rows":[["&&","و (AND)","تتحقق إذا كان الشرطان صحيحين","x > 0 && x < 10","صحيح فقط إذا x بين 1 و9"],["||","أو (OR)","تتحقق إذا كان أحد الشرطين صحيح","x > 0 || x < 10","صحيح إذا x بين اكبر من صفر او اصغر من 10"],["!","ليس (NOT)","تعكس النتيجة","!(x > 5)","صحيح إذا x ≤ 5"]],"columnDirs":["ltr","rtl","rtl","ltr","rtl"]},{"id":"m02-l01-p02-b07","type":"heading","origin":"book","level":3,"text":"🔹 ج. عوامل المقارنة (Comparison Operators):"},{"id":"m02-l01-p02-b08","type":"table","origin":"book","headers":["العامل","المعنى","مثال","النتيجة"],"rows":[["==","يساوي","x == 5","صحيح إذا x = 5"],["!=","لا يساوي","x != 0","صحيح إذا x ≠ 0"],[">","أكبر من","x > 3","صحيح إذا x > 3"],["<","أصغر من","x < 10","صحيح إذا x < 10"],[">=","أكبر أو يساوي","x >= 7","صحيح إذا x ≥ 7"],["<=","أصغر أو يساوي","x <= 4","صحيح إذا x ≤ 4"]],"columnDirs":["ltr","rtl","ltr","rtl"]}]},{"id":"899371-m02-l01-p03","title":"أمثلة توضيحية","order":3,"source":{"kind":"book","sourceId":"899371","pdfPageStart":9,"printedPage":9,"sourceNote":"¶150–172"},"blocks":[{"id":"m02-l01-p03-b01","type":"heading","origin":"book","level":3,"text":"🧪 أمثلة توضيحية:"},{"id":"m02-l01-p03-b02","type":"heading","origin":"book","level":3,"text":"✏️ المثال 1:"},{"id":"m02-l01-p03-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"int age = 16;\nbool isTeen = age >= 13 && age <= 19;\nConsole.WriteLine(isTeen);"},{"id":"m02-l01-p03-b04","type":"text","origin":"book","spans":[{"text":"الشرح:","style":"strong"},{"text":" هل العمر بين 13 و 19؟"}]},{"id":"m02-l01-p03-b05","type":"text","origin":"book","spans":[{"text":"✅ الناتج: True لأن العمر 16."}]},{"id":"m02-l01-p03-b06","type":"heading","origin":"book","level":3,"text":"✏️ المثال 2:"},{"id":"m02-l01-p03-b07","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"int number = 7;\nConsole.WriteLine(number % 2 == 0);"},{"id":"m02-l01-p03-b08","type":"text","origin":"book","spans":[{"text":"الشرح:","style":"strong"},{"text":" هل العدد زوجي؟"}]},{"id":"m02-l01-p03-b09","type":"text","origin":"book","spans":[{"text":"✖️ الناتج: False لأن 7 عدد فردي."}]},{"id":"m02-l01-p03-b10","type":"heading","origin":"book","level":3,"text":"✏️ المثال 3:"},{"id":"m02-l01-p03-b11","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"int x = 4;\nbool result = !(x > 5);\nConsole.WriteLine(result);"},{"id":"m02-l01-p03-b12","type":"text","origin":"book","spans":[{"text":"الشرح:","style":"strong"},{"text":" هل x ليس أكبر من 5؟"}]},{"id":"m02-l01-p03-b13","type":"text","origin":"book","spans":[{"text":"✅ الناتج: True لأن x = 4."}]}]}]},{"id":"899371-m02-l02","title":"الوظيفة الثانية بيتية","order":2,"pages":[{"id":"899371-m02-l02-p01","title":"السؤال 1","order":1,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶173–185"},"blocks":[{"id":"m02-l02-p01-b01","type":"heading","origin":"book","level":2,"text":"الوظيفة الثانية في أسس علم الحاسوب - بيتية"},{"id":"m02-l02-p01-b02","type":"heading","origin":"book","level":3,"text":"الوظيفة: المعاملات والتعابير المنطقية"},{"id":"m02-l02-p01-b03","type":"heading","origin":"book","level":3,"text":"🔹 القسم الأول: أسئلة تتبّع (Tracing)"},{"id":"m02-l02-p01-b04","type":"text","origin":"book","spans":[{"text":"1. تتبّع البرنامج التالي واكتب القيم المطبوعة:","style":"strong"}]},{"id":"m02-l02-p01-b05","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int x = 5;\n    x++;\n    Console.WriteLine(x);\n    x--;\n    Console.WriteLine(x);\n}"}]},{"id":"899371-m02-l02-p02","title":"السؤال 2","order":2,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶186–193"},"blocks":[{"id":"m02-l02-p02-b01","type":"text","origin":"book","spans":[{"text":"2. ما الذي تتم طباعته عند تنفيذ البرنامج التالي؟","style":"strong"}]},{"id":"m02-l02-p02-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int a = 10;\n    a += 5;\n    a -= 3;\n    Console.WriteLine(a);\n}"}]},{"id":"899371-m02-l02-p03","title":"السؤال 3","order":3,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶194–199"},"blocks":[{"id":"m02-l02-p03-b01","type":"text","origin":"book","spans":[{"text":"3. تتبّع السطر التالي:","style":"strong"}]},{"id":"m02-l02-p03-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int n = 7;\n    Console.WriteLine((n % 2 == 0));\n}"}]},{"id":"899371-m02-l02-p04","title":"السؤال 4","order":4,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶200–206"},"blocks":[{"id":"m02-l02-p04-b01","type":"text","origin":"book","spans":[{"text":"4. ما ناتج التعابير التالية؟","style":"strong"}]},{"id":"m02-l02-p04-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int x = 4, y = 9;\n    Console.WriteLine((x * 2 > y) && (y - 5 < x));\n}"}]},{"id":"899371-m02-l02-p05","title":"السؤال 5","order":5,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶207–216"},"blocks":[{"id":"m02-l02-p05-b01","type":"text","origin":"book","spans":[{"text":"5. تتبّع البرنامج وحدد النواتج:","style":"strong"}]},{"id":"m02-l02-p05-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int a = 3, b = 5;\n    a++;\n    b += 2;\n    Console.WriteLine(a > b);\n}"},{"id":"m02-l02-p05-b03","type":"heading","origin":"book","level":3,"text":"🔹 القسم الثاني: كتابة تعابير"}]},{"id":"899371-m02-l02-p06","title":"الأسئلة 6–9","order":6,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶217–220"},"blocks":[{"id":"m02-l02-p06-b01","type":"text","origin":"book","spans":[{"text":"6. اكتب تعبيرًا منطقيًا يتحقق إن كان العدد x أكبر من 10 وأصغر من 20.","style":"strong"}]},{"id":"m02-l02-p06-b02","type":"text","origin":"book","spans":[{"text":"7. اكتب تعبيرًا منطقيًا يتحقق إن كان العدد n فرديًا (أي لا يقبل القسمة على 2).","style":"strong"}]},{"id":"m02-l02-p06-b03","type":"text","origin":"book","spans":[{"text":"8. اكتب تعبيرًا منطقيًا يتحقق إن كان العدد a مضاعفًا للعدد b.","style":"strong"}]},{"id":"m02-l02-p06-b04","type":"text","origin":"book","spans":[{"text":"9. اكتب تعبيرًا منطقيًا يعيد true إذا كان العدد age أكبر أو يساوي 18 أو يساوي 0.","style":"strong"}]}]},{"id":"899371-m02-l02-p07","title":"السؤال 10","order":7,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶221–223"},"blocks":[{"id":"m02-l02-p07-b01","type":"text","origin":"book","spans":[{"text":"10. اكتب تعبيرًا حسابيًا مختصرًا (باستخدام += أو -=) يزيد قيمة المتغير score بمقدار 10 ثم ينقصها بمقدار 3.","style":"strong"}]},{"id":"m02-l02-p07-b02","type":"heading","origin":"book","level":3,"text":"🔹 القسم الثالث: أسئلة أصعب"}]},{"id":"899371-m02-l02-p08","title":"السؤال 11","order":8,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶224–231"},"blocks":[{"id":"m02-l02-p08-b01","type":"text","origin":"book","spans":[{"text":"11. تتبّع البرنامج التالي واكتب الناتج:","style":"strong"}]},{"id":"m02-l02-p08-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int x = 5, y = 8;\n    x += 2;\n    y--;\n    Console.WriteLine((x * 2 > y) || (y % 2 == 0));\n}"}]},{"id":"899371-m02-l02-p09","title":"السؤال 12","order":9,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶232–239"},"blocks":[{"id":"m02-l02-p09-b01","type":"text","origin":"book","spans":[{"text":"12. ما القيمة المطبوعة؟","style":"strong"}]},{"id":"m02-l02-p09-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int a = 10;\n    a--;\n    a *= 2;\n    Console.WriteLine((a == 18) && (a % 3 == 0));\n}"}]},{"id":"899371-m02-l02-p10","title":"السؤال 13","order":10,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶240–247"},"blocks":[{"id":"m02-l02-p10-b01","type":"text","origin":"book","spans":[{"text":"13. تتبّع البرنامج التالي:","style":"strong"}]},{"id":"m02-l02-p10-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int n = 15;\n    n /= 3;\n    n += 4;\n    Console.WriteLine(!(n < 10));\n}"}]},{"id":"899371-m02-l02-p11","title":"السؤال 14","order":11,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶248"},"blocks":[{"id":"m02-l02-p11-b01","type":"text","origin":"book","spans":[{"text":"14. اكتب تعبيرًا منطقيًا يتحقق إن كان العدد x أكبر من 0، وأيضًا (يقع بين 5 و 10 أو يساوي 20).","style":"strong"}]}]},{"id":"899371-m02-l02-p12","title":"السؤال 15","order":12,"source":{"kind":"book","sourceId":"899371","pdfPageStart":12,"printedPage":12,"sourceNote":"¶249–266"},"blocks":[{"id":"m02-l02-p12-b01","type":"text","origin":"book","spans":[{"text":"15. تتبّع البرنامج وحدد القيم المطبوعة:","style":"strong"}]},{"id":"m02-l02-p12-b02","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int a = 7, b = 2, c = 5;\n    a += b;\n    c--;\n    Console.WriteLine((a > c) && (c + b == a));\n}"}]}]},{"id":"899371-m02-l03","title":"الوظيفة الثانية برمجة","order":3,"pages":[{"id":"899371-m02-l03-p01","title":"السؤال 1","order":1,"source":{"kind":"book","sourceId":"899371","pdfPageStart":15,"printedPage":15,"sourceNote":"¶267–277"},"blocks":[{"id":"m02-l03-p01-b01","type":"heading","origin":"book","level":2,"text":"الوظيفة الثانية في أسس علم الحاسوب - برمجية"},{"id":"m02-l03-p01-b02","type":"text","origin":"book","spans":[{"text":"السؤال 1 (10 علامات)","style":"strong"}]},{"id":"m02-l03-p01-b03","type":"text","origin":"book","spans":[{"text":"تتبع البرنامج التالي، ثم أجب: ماذا يظهر على الشاشة؟"}]},{"id":"m02-l03-p01-b04","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int a = 4;\n    int b = 2;\n    a += 3;\n    b *= a;\n    Console.WriteLine(a + b);\n}"}]},{"id":"899371-m02-l03-p02","title":"السؤال 2","order":2,"source":{"kind":"book","sourceId":"899371","pdfPageStart":15,"printedPage":15,"sourceNote":"¶278–287"},"blocks":[{"id":"m02-l03-p02-b01","type":"text","origin":"book","spans":[{"text":"السؤال 2 (10 علامات)","style":"strong"}]},{"id":"m02-l03-p02-b02","type":"text","origin":"book","spans":[{"text":"تتبع البرنامج التالي، ثم حدد الناتج النهائي الظاهر على الشاشة."}]},{"id":"m02-l03-p02-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    int x = 10;\n    x++;\n    int y = x * 2;\n    x -= 3;\n    Console.WriteLine(x + y);\n}"}]},{"id":"899371-m02-l03-p03","title":"السؤال 3","order":3,"source":{"kind":"book","sourceId":"899371","pdfPageStart":15,"printedPage":15,"sourceNote":"¶288–298"},"blocks":[{"id":"m02-l03-p03-b01","type":"text","origin":"book","spans":[{"text":"السؤال 3 (10 علامات)","style":"strong"}]},{"id":"m02-l03-p03-b02","type":"text","origin":"book","spans":[{"text":"تتبع البرنامج التالي وأجب: ما القيمة التي تُطبع؟"}]},{"id":"m02-l03-p03-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static void Main(string[] args)\n{\n    in