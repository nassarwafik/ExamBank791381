,"dir":"ltr"},{"text":"."}]}],"result":[{"text":"يطبع البرنامج: "},{"text":"True","style":"code","dir":"ltr"}],"explanation":"كما يسبق الضرب الجمع، تسبق && (و) العامل || (أو). عند الشك نضع أقواسًا لتوضيح الترتيب."},{"id":"m02-l01-p04-trace","type":"simulation","origin":"teacher-enrichment","simulationType":"csharp-trace","version":1,"title":"تتبّع البرنامج خطوة خطوة","capabilities":{"fullscreen":true,"reset":true,"interactive":true},"config":{"code":"int a = 5, b = 10, c = 15;\nConsole.WriteLine(a > b || b < c && c > 20 || a == 5);","steps":[{"line":1,"note":"ثلاثة صناديق.","frames":[{"name":"Main","vars":[["a",{"t":"v","s":"5"}],["b",{"t":"v","s":"10"}],["c",{"t":"v","s":"15"}]]}],"eval":[],"heap":[],"out":""},{"line":2,"note":"نحسب كل مقارنة أولًا.","frames":[{"name":"Main","vars":[["a",{"t":"v","s":"5"}],["b",{"t":"v","s":"10"}],["c",{"t":"v","s":"15"}]]}],"eval":[["a > b",{"t":"v","s":"False"}],["b < c",{"t":"v","s":"True"}],["c > 20",{"t":"v","s":"False"}],["a == 5",{"t":"v","s":"True"}]],"heap":[],"out":""},{"line":2,"note":"&& قبل ||: نحسب b < c && c > 20.","frames":[{"name":"Main","vars":[["a",{"t":"v","s":"5"}],["b",{"t":"v","s":"10"}],["c",{"t":"v","s":"15"}]]}],"eval":[["b < c && c > 20",{"t":"v","s":"False"}]],"heap":[],"out":""},{"line":2,"note":"ثم || من اليسار: False || False ثم || True.","frames":[{"name":"Main","vars":[["a",{"t":"v","s":"5"}],["b",{"t":"v","s":"10"}],["c",{"t":"v","s":"15"}]]}],"eval":[["a > b || b < c && c > 20",{"t":"v","s":"False"}],["… || a == 5",{"t":"v","s":"True"}]],"heap":[],"out":""},{"line":2,"note":"الطباعة: True، يكفي طرف صحيح واحد مع ||.","frames":[{"name":"Main","vars":[["a",{"t":"v","s":"5"}],["b",{"t":"v","s":"10"}],["c",{"t":"v","s":"15"}]]}],"eval":[],"heap":[],"out":"True\n"}]}}]},{"id":"899371-m02-l01-p05","title":"نحلّ معًا: جدولا && و||","order":5,"source":{"kind":"book","sourceId":"899371","pdfPageStart":9,"printedPage":9,"sourceNote":"إثراء: نحلّ معًا — مثال موازٍ لملخص الفصل (ليس من الكتاب)"},"blocks":[{"id"