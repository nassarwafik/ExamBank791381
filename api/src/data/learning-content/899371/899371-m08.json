2-p01-b05","type":"text","origin":"book","spans":[{"text":"1.1 - ","style":"strong"},{"text":" ما هو المخرج بعد تنفيذ البرنامج؟"}]},{"id":"m08-l02-p01-b06","type":"text","origin":"book","spans":[{"text":"1.2 - ","style":"strong"},{"text":" ماذا تنفّذ العملية sod (اشرح باختصار وظيفتها)؟"}]}]},{"id":"899371-m08-l02-p02","title":"السؤال 2","order":2,"source":{"kind":"book","sourceId":"899371","pdfPageStart":88,"printedPage":88,"sourceNote":"¶1960–1975"},"blocks":[{"id":"m08-l02-p02-b01","type":"text","origin":"book","spans":[{"text":"السؤال 2 – تحليل دالة فحص تناظر (Palindrome)","style":"strong"}]},{"id":"m08-l02-p02-b02","type":"text","origin":"book","spans":[{"text":"تمعّن في مقطع البرنامج التالي ثم أجب عن الأسئلة:"}]},{"id":"m08-l02-p02-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static bool sod(string str)\n{\n    int left = 0;\n    int right = str.Length - 1;\n    while (left < right)\n    {\n        if (str[left] != str[right])\n            return false;\n        left++;\n        right--;\n    }\n    return true;\n}"},{"id":"m08-l02-p02-b04","type":"text","origin":"book","spans":[{"text":"2.1 - ","style":"strong"},{"text":" ما هو المخرج بعد تنفيذ الاستدعاء: sod(\"abba\""}]},{"id":"m08-l02-p02-b05","type":"text","origin":"book","spans":[{"text":"2.2 - ","style":"strong"},{"text":" ماذا تنفّذ العملية sod (اشرح باختصار وظيفتها)؟"}]}]},{"id":"899371-m08-l02-p03","title":"السؤال 3","order":3,"source":{"kind":"book","sourceId":"899371","pdfPageStart":88,"printedPage":88,"sourceNote":"¶1976–2002"},"blocks":[{"id":"m08-l02-p03-b01","type":"text","origin":"book","spans":[{"text":"السؤال 3 – تحليل دالة تشفير بإزاحة (قيصر)","style":"strong"}]},{"id":"m08-l02-p03-b02","type":"text","origin":"book","spans":[{"text":"تمعّن في مقطع البرنامج التالي ثم أجب عن الأسئلة:"}]},{"id":"m08-l02-p03-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static string sod(string str, int n)\n{\n    string result = \"\";\n    for (int i = 0; i < str.Length; i++)\n    {\n        char ch = str[i];\n        if (ch >= 'A' && ch <= 'Z')\n        {\n            ch = (char)((ch + n - 65) % 26 + 65);\n        }\n        else if (ch >= 'a' && ch <= 'z')\n        {\n            ch = (char)((ch + n - 97) % 26 + 97);\n        }\n        result += ch;\n    }\n    return result;\n}\nstatic void Main(string[] args)\n{\n    Console.WriteLine(sod(\"XYZ\", 2));\n}"},{"id":"m08-l02-p03-b04","type":"text","origin":"book","spans":[{"text":"3.1 - ","style":"strong"},{"text":" ما هو المخرج بعد تنفيذ الاستدعاء: sod(\"XYZ\", 2)؟"}]},{"id":"m08-l02-p03-b05","type":"text","origin":"book","spans":[{"text":"3.2 - ","style":"strong"},{"text":" ماذا تنفّذ العملية sod (اشرح آلية عملها وما الذي تفعله مع الأحرف الكبيرة والصغيرة)؟"}]}]},{"id":"899371-m08-l02-p04","title":"السؤال 4","order":4,"source":{"kind":"book","sourceId":"899371","pdfPageStart":88,"printedPage":88,"sourceNote":"¶2003–2027"},"blocks":[{"id":"m08-l02-p04-b01","type":"text","origin":"book","spans":[{"text":"السؤال 4 – توليد عدد كبير بعدد منازل محدّد","style":"strong"}]},{"id":"m08-l02-p04-b02","type":"text","origin":"book","spans":[{"text":"تمعّن في مقطع البرنامج التالي ثم أجب عن الأسئلة:"}]},{"id":"m08-l02-p04-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static string sod(int n)\n{\n  Random rand = new Random();\n  string result = \"\";\n  result += rand.Next(1, 10);\n  for (int i = 1; i < n; i++)\n  {\n      result += rand.Next(0, 10); // باقي الأرقام: 0..9\n     }\n      return result;\n }\n\n static void Main(string[] args)\n {\n  Console.Write(\"Enter number of digits: \");\n  int digits = int.Parse(Console.ReadLine());\n  string bigNumber = sod(digits);\n  Console.WriteLine(\"Big number with \" + digits + \" digits:\");\n  Console.WriteLine(bigNumber);\n }"},{"id":"m08-l02-p04-b04","type":"text","origin":"book","spans":[{"text":"4.1 - ","style":"strong"},{"text":" ما هو المخرج بعد استدعاء العملية sod(7) إذا كانت الأعداد العشوائية (بالترتيب) هي:"}]},{"id":"m08-l02-p04-b05","type":"text","origin":"book","spans":[{"text":"6, 9, 2, 6, 1, 5, 8؟"}]},{"id":"m08-l02-p04-b06","type":"text","origin":"book","spans":[{"text":"4.2 - ","style":"strong"},{"text":" ماذا تنفّذ العملية sod (اشرح باختصار وظيفتها وآلية منع الصفر في أول رقم)؟"}]}]},{"id":"899371-m08-l02-p05","title":"السؤال 5","order":5,"source":{"kind":"book","sourceId":"899371","pdfPageStart":88,"printedPage":88,"sourceNote":"¶2028–2071"},"blocks":[{"id":"m08-l02-p05-b01","type":"text","origin":"book","spans":[{"text":"السؤال 5 – تنظيف نص وإخراج نمط موحّد","style":"strong"}]},{"id":"m08-l02-p05-b02","type":"text","origin":"book","spans":[{"text":"تمعّن في مقطع البرنامج التالي ثم أجب عن الأسئلة:"}]},{"id":"m08-l02-p05-b03","type":"code","origin":"book","language":"csharp","dir":"ltr","code":"static string CleanString(string input)\n{\n    string result = \"\";\n    for (int i = 0; i < input.Length; i++)\n    {\n        char ch = input[i];\n        if (char.IsLetter(ch))\n        {\n            result += char.ToLower(ch);\n        }\n        else\n        {\n            result += '*';\n        }\n    }\n    return result;\n}\n\nstatic void Main(string[] args)\n{\n    string test = \"Ab3cD!\";\n    string output = CleanString(test);\n    Console.WriteLine(output);\n}"},{"id":"m08-l02-p05-b04","type":"text","origin":"book","spans":[{"text":"5.1 - ","style":"strong"},{"text":" ما هو المخرج بعد تنفيذ البرنامج؟"}]},{"id":"m08-l02-p05-b05","type":"text","origin":"book","spans":[{"text":"5.2 - ","style":"strong"},{"text":" ماذا تنفّذ العملية CleanString (اشرح كيف تتعامل مع الحروف وغير الحروف)؟"}]},{"id":"m08-l02-p05-b06","type":"text","origin":"book","spans":[{"text":"5.3 - ","style":"strong"},{"text":" أعطِ مثالًا لاستدعاءٍ للدالة CleanString لا تتغيّر فيه قيمة النص المُعاد مقارنة بالنص المُدخل."}]}]}]},{"id":"899371-m08-l03","title":"الوظيفة الثامنة برمجة","order":3,"pages":[{"id":"899371-m08-l03-p01","title":"السؤال 1","order":1,"source":{"kind":"boo