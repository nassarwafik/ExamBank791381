1","q2","q3"],"alphabet":["a","b"],"start":"q0","accept":["q0","q2"],"transitions":[{"from":"q0","read":"a","top":"⏊","op":"push","write":"S","to":"q1"},{"from":"q1","read":"a","top":"S","op":"push","write":"A","to":"q1"},{"from":"q1","read":"a","top":"A","op":"push","write":"A","to":"q1"},{"from":"q1","read":"b","top":"S","op":"pop","write":"S","to":"q2"},{"from":"q1","read":"b","top":"A","op":"pop","write":"A","to":"q3"},{"from":"q3","read":"b","top":"A","op":"pop","write":"A","to":"q3"},{"from":"q3","read":"b","top":"S","op":"pop","write":"S","to":"q2"}],"stackAlphabet":["S","A"]},"words":["aabb"]},"fallback":{"text":"رسم الآلة التفاعلي: PDA بحالات q0، q1، q2، q3."},"origin":"teacher-enrichment"},{"id":"m09-l02-p02-b05","type":"list","variant":"ordered","title":"خطوات بناء أوتومات مكدّس غير حتمي يقبل L1 ∪ L2","items":[{"id":"i1","text":[{"text":"نضيف حالة بداية جديدة "},{"text":"q0new","dir":"ltr"},{"text":". إذا كانت إحدى حالات البداية الأصلية حالة قبول فهي حالة قبول، وإلا فلا."}]},{"id":"i2","text":[{"text":"من حالة البداية الجديدة "},{"text":"q0new","dir":"ltr"},{"text":" نُخرج كل الانتقالات التي كانت تخرج من حالات البداية الأصلية."}]}],"origin":"book"},{"id":"m09-l02-p02-b06","type":"callout","kind":"clarification","title":"لماذا غير حتمي؟","spans":[{"text":"من "},{"text":"q0new","dir":"ltr"},{"text":" يخرج انتقالان بالرمز "},{"text":"a","dir":"ltr"},{"text":" والقاع "},{"text":"⏊","dir":"ltr"},{"text":": واحد إلى أوتومات "},{"text":"L1","dir":"ltr"},{"text":" وواحد إلى أوتومات "},{"text":"L2","dir":"ltr"},{"text":". لذلك أوتومات الاتحاد هنا "},{"text":"غير حتمي","style":"strong"},{"text":" — وهذا مسموح، فالتعريف «يوجد أوتومات مكدّس» يشمل غير الحتمي."}],"origin":"teacher-enrichment"}]},{"id":"899271-m09-l02-p03","title":"التقاطع والمتمّمة","order":3,"source":{"kind":"book","sourceId":"899271","pdfPageStart":36,"pdfPageEnd":42,"sourceNote":"اللقاء 5 · الشرائح 36–42"},"blocks":[{"id":"m09-l02-p03-b01","type":"heading","level":3,"text":"التقاطع: `L1 ∩ L2`","origin":"book"},{"id":"m09-l02-p03-b02","type":"text","spans":[{"text":"سؤال:","style":"strong"},{"text":" هل تقاطع لغات خالية من السياق بالضرورة لغة خالية من السياق؟ "},{"text":"الجواب:","style":"strong"},{"text":" لا."}],"origin":"book"},{"id":"m09-l02-p03-b03","type":"text","spans":[{"text":"البرهان","style":"strong"},{"text":" (بإعطاء مثال مضاد): "},{"text":"L1 = {aⁿbⁿcᵐ | n, m ≥ 1}","dir":"ltr"},{"text":" و "},{"text":"L2 = {aⁿbᵐcᵐ | n, m ≥ 1}","dir":"ltr"},{"text":"، و "},{"text":"L = L1 ∩ L2 = {aⁿbⁿcⁿ | n ≥ 1}","dir":"ltr"},{"text":". اللغتان خاليتان من السياق، لأنه يمكن بناء أوتومات مكدّس يقبلهما. لكن لغة التقاطع ليست خالية من السياق، لأنه لا يمكن بناء أوتومات مكدّس يعمل مقارنة بين ثلاث قوى غير منتهية."}],"origin":"book"},{"id":"m09-l02-p03-b04","type":"heading","level":3,"text":"المتمّمة: `L̄`","origin":"book"},{"id":"m09-l02-p03-b05","type":"text","spans":[{"text":"سؤال:","style":"strong"},{"text":" هل متمّمة لغة خالية من السياق بالضرورة خالية من السياق؟ "},{"text":"الجواب:","style":"strong"},{"text":" لا."}],"origin":"book"},{"id":"m09-l02-p03-b06","type":"list","variant":"ordered","title":"البرهان","items":[{"id":"i1","text":[{"text":"نبرهن أولًا أنه يتحقق: "},{"text":"L̄1 ∪ L̄2","dir":"ltr"},{"text":" متمّمته "},{"text":"= L1 ∩ L2","dir":"ltr"},{"text":" (أحد قوانين دي مورغان)."}]},{"id":"i2","text":[{"text":"نلوّن "},{"text":"L̄1","dir":"ltr"},{"text":" (خارج "},{"text":"L1","dir":"ltr"},{"text":") ونلوّن "},{"text":"L̄2","dir":"ltr"},{"text":" (خارج "},{"text":"L2","dir":"ltr"},{"text":"). "},{"text":"L̄1 ∪ L̄2","dir":"ltr"},{"text":" هو كل المستطيل ما عدا الجزء غير الملوّن: تقاطع "},{"text":"L1","dir":"ltr"},{"text":" و "},{"text":"L2","dir":"ltr"},{"text":"."}]},{"id":"i3","text":[{"text":"إذن متمّمة "},{"text":"L̄1 ∪ L̄2","dir":"ltr"},{"text":" هي بالضبط "},{"text":"L1 ∩ L2","dir":"ltr"},{"text":"."}]}],"origin":"book"},{"id":"m09-l02-p03-b07","type":"text","spans":[{"text":"لو كانت اللغات الخالية من السياق منغلقة على المتمّمة، فلأنها منغلقة على الاتحاد لكان "},{"text":"L1 ∩ L2","dir":"ltr"},{"text":" (متمّمة اتحاد متمّمتين) خاليًا من السياق دائمًا. لكننا رأينا تقاطعًا ليس كذلك — تناقض."}],"origin":"teacher-enrichment"},{"id":"m09-l02-p03-b08","type":"callout","kind":"warning","title":"في الشرائح","spans":[{"text":"رسم فِن: المستطيل كل الكلمات، ودائرتان "},{"text":"L1","dir":"ltr"},{"text":" و "},{"text":"L2","dir":"ltr"},{"text":". تلوين خارج "},{"text":"L1","dir":"ltr"},{"text":" بالأخضر وخارج "},{"text":"L2","dir":"ltr"},{"text":" بالأحمر يغطي كل المستطيل ما عدا التقاطع."}],"origin":"teacher-enrichment"}]},{"id":"899271-m09-l02-p04","title":"العكس وخلاصة","order":4,"source":{"kind":"book","sourceId":"899271","pdfPageStart":43,"pdfPageEnd":46,"sourceNote":"اللقاء 5 · الشرائح 43–46"},"blocks":[{"id":"m09-l02-p04-b01","type":"text","spans":[{"text":"سؤال:","style":"strong"},{"text":" هل عكس لغات خالية من السياق بالضرورة لغة خالية من السياق؟ "},{"text":"الجواب:","style":"strong"},{"text":" نعم. "},{"text":"البرهان:","style":"strong"},{"text":" ببناء أوتومات العكس — لن ندرجه (لا يُطلب البرهان عليه في إطار الوحدة)."}],"origin":"book"},{"id":"m09-l02-p04-b02","type":"text","spans":[{"text":"الفكرة العامة:","style":"strong"},{"text":" إذا أمكن بناء أوتومات مكدّس حين نقرأ الكلمة من اليسار إلى اليمين، يمكن بناء أوتومات مكدّس حين نقرأ الكلمة من اليمين إلى اليسار."}],"origin":"book"},{"id":"m09-l02-p04-b03","type":"callout","kind":"summary","title":"خلاصة","spans":[{"text":"اللغات الخالية من السياق منغلقة على الاتحاد والتسلسل والعكس، وليست منغلقة على التقاطع والمتمّمة و«لغة جزئية»."}],"origin":"book"},{"id":"m09-l02-p04-b04","type":"table","headers":["العملية","هل اللغات الخالية من السياق منغلقة عليها؟"],"rows":[["مجموعة جزئية","✗"],["اتحاد اللغات","✓"],["تقاطع اللغات","✗"],["تسلسل اللغات","✓"],["عكس اللغة","✓"],["اللغة المتمّمة","✗"]],"origin":"book"}]}]},{"id":"899271-m09-l03","title":"تدريبات الوحدة","order":3,"pages":[{"id":"899271-m09-l03-p01","title":"تدريبات الوحدة (1)","order":1,"source":{"kind":"book","sourceId":