":2,"source":{"kind":"book","sourceId":"791381","pdfPageStart":31,"printedPage":29},"blocks":[{"id":"m07-l02-p02-table","type":"table","origin":"book","headers":["الفئة","العنوان الخاص","مثال"],"columnDirs":["ltr","ltr","ltr"],"rows":[["Class A","10.x.x.x","10.0.0.1"],["Class B","172.16 - 172.31","172.23.100.13"],["Class C","192.168.x.x","192.168.100.6"]]},{"id":"m07-l02-p02-benefit","type":"callout","origin":"book","kind":"tip","title":"الفائدة","spans":[{"text":"معرفة هذه المجالات تساعدك على التمييز السريع بين الشبكات الداخلية والعناوين العامة على الإنترنت."}]},{"id":"m07-l02-p02-remember","type":"callout","origin":"book","kind":"remember","title":"تذكّر","spans":[{"text":"إذا رأيت "},{"text":"10","dir":"ltr","style":"code"},{"text":" أو "},{"text":"192.168","dir":"ltr","style":"code"},{"text":" فغالبًا أنت أمام عنوان خاص."}]},{"id":"m07-l02-p02-172","type":"callout","origin":"book","kind":"warning","title":"انتبه لـ 172","spans":[{"text":"يجب أن يكون القسم الثاني بين 16 و 31 فقط ليكون العنوان خاصًا."}]}]},{"id":"791381-m07-l02-p03","title":"تدريب: خاص أم عام؟","order":3,"source":{"kind":"book","sourceId":"791381","pdfPageStart":32,"printedPage":30},"blocks":[{"id":"m07-l02-p03-table","type":"practice-table","origin":"book","headers":["الجهاز","العنوان","خاص / عام"],"columnDirs":["ltr","ltr","rtl"],"rows":[["PC1","192.167.100.2",{"kind":"select","options":["خاص","عام"],"key":"عام"}],["PC2","10.100.10.10",{"kind":"select","options":["خاص","عام"],"key":"خاص"}],["PC3","172.16.32.30",{"kind":"select","options":["خاص","عام"],"key":"خاص"}],["PC4","220.100.100.100",{"kind":"select","options":["خاص","عام"],"key":"عام"}],["PC5","9.10.11.12",{"kind":"select","options":["خاص","عام"],"key":"عام"}]]},{"id":"m07-l02-p03-warn","type":"callout","origin":"book","kind":"warning","title":"لا تنخدع","spans":[{"text":"العنوان "},{"text":"192.167","dir":"ltr","style":"code"},{"text":" ليس مثل "},{"text":"192.168","dir":"ltr","style":"code"},{"text":" — افحص الأرقام بدقة قبل الحكم."}]}]