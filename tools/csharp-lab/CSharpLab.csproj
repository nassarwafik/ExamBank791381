<!-- Teacher C# lab (docs/enterprise-teacher-csharp-lab-spike.md; V1 in docs/enterprise-csharp-visual-lab-plan.md): the teacher's
     in-browser C# compiler. Built and proven in Chromium by .github/workflows/csharp-lab.yml; published into the site's /csharp-lab/
     by scripts/build-csharp-lab.mjs in the deploy job. Teacher only, books only, desktop only, never used for grading. -->
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- the same invariant globalization as the Runner's csharp@1 worker (toolchain.json); also leaves ICU out of the download -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- UNTRIMMED: a teacher's program may call any BCL API, which trimming could remove (trimming is plan phase V6, measured) -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- plain file names, so lab-worker.js imports ./_framework/dotnet.js without a build-time placeholder; the site serves
         /csharp-lab/* with Cache-Control: no-cache (staticwebapp.config.json), so a new deployment is never mixed with a cached one -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
    <!-- the compiler's messages in English only (as the Runner prints them): no localized resource folders in the download -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- no pre-compressed .br / .gz copies: the site's host compresses on the fly, and the copies would double the upload -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.15" />
  </ItemGroup>
</Project>
